# =====================================================================
#  Backend settings for the LIVE server. Copy to backend/.env on the server and fill every TODO.
#  Check it with:  npm run check
# =====================================================================

NODE_ENV=production
PORT=5001
# TODO: public HTTPS address of the API, e.g. https://api.your-domain.org
API_URL=
# TODO: public HTTPS address of the website, e.g. https://your-domain.org (comma-separate if several)
CLIENT_URL=
# 1 when behind one load balancer/proxy (Render, Railway, Nginx, Cloudflare...). Wrong value = shared rate limits.
TRUST_PROXY=1
SLOW_REQUEST_MS=1000
API_RATE_LIMIT_PER_MIN=3000
# mongo = one limit across all servers (use when running more than one)
API_RATE_LIMIT_STORE=memory

# TODO: new random secret for production: openssl rand -hex 32   (never reuse the development one)
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=olympiad_admin
# lax when website and API share a domain (your-domain.org + api.your-domain.org); none if on different domains
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
# e.g. .your-domain.org when website and API are subdomains of it; otherwise leave empty
COOKIE_DOMAIN=
# Only for the first `npm run seed`; remove the password afterwards
ADMIN_EMAIL=
ADMIN_PASSWORD=

# TODO: Atlas connection string (use a database user with access to this database only)
MONGODB_URI=
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
MONGO_CONNECT_TIMEOUT_MS=8000
MONGO_SOCKET_TIMEOUT_MS=30000
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=4
# Production: run `npm run db:indexes` on each deploy instead of building indexes at startup
MONGO_AUTO_INDEX=false

HOME_CACHE_MS=60000
LIST_CACHE_MS=30000
DASHBOARD_CACHE_MS=10000
CACHE_MAX_ENTRIES=500
CACHE_SYNC_MS=2000

# Brevo free plan (300/day). TODO: SMTP_USER = "Login" and SMTP_PASS = "SMTP key" from Brevo -> SMTP & API -> SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# TODO: address on your verified sending domain
EMAIL_FROM="Mathematical Olympiad <updates@your-domain.org>"
# Optional: where replies go. Empty = replies go to EMAIL_FROM.
EMAIL_REPLY_TO=
NOTIFY_POLL_MS=10000
NOTIFY_BATCH_SIZE=100
NOTIFY_CONCURRENCY=5
NOTIFY_LOCK_MS=300000
# Brevo free plan limit; emails beyond it are sent after midnight UTC
NOTIFY_DAILY_LIMIT=300

MAX_UPLOAD_MB=50
UPLOAD_DIR=

# TODO: Cloudflare R2 (required in production so every server sees the same files)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_STORAGE_LIMIT_GB=9.5
MAX_R2_UPLOAD_GB=9.5
R2_PART_SIZE_BYTES=67108864
R2_ENDPOINT=

JOBS_ENABLED=true
STORAGE_RECONCILE_MS=3600000
ORPHAN_CLEANUP_MS=86400000
ORPHAN_GRACE_HOURS=24
