# --- Server ---
NODE_ENV=development
PORT=5001
# Public base URL of this API (used for uploaded-file links and unsubscribe links in emails)
API_URL=http://localhost:5001
# Allowed frontend origin(s), comma-separated. The first one is used for links in emails.
CLIENT_URL=http://localhost:5173
# Number of proxies/load balancers in front of the API (1 on most hosts). Needed for correct client IPs.
TRUST_PROXY=false
SLOW_REQUEST_MS=1000
# Per-instance request cap per IP per minute (schools often share one IP). 0 disables.
API_RATE_LIMIT_PER_MIN=3000
# memory = per instance (no DB cost) | mongo = one shared limit across instances
API_RATE_LIMIT_STORE=memory

# --- Auth ---
# At least 32 random characters: `openssl rand -hex 32` (required in production)
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
# Used only by `npm run seed` to create/reset the first admin (no defaults; password min 10 chars).
# More admins / password changes: Admin -> "Admins & Password" page.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Admin session cookie (httpOnly). Frontend on a different site than the API in production ->
# COOKIE_SAMESITE=none + HTTPS. Same site (e.g. app.x.org + api.x.org) -> keep lax.
COOKIE_SAMESITE=lax
COOKIE_SECURE=
COOKIE_DOMAIN=

# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017/mathematical-olympiad-cms
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000
MONGO_CONNECT_TIMEOUT_MS=8000
MONGO_SOCKET_TIMEOUT_MS=30000
MONGO_MAX_POOL_SIZE=20
# Connections kept open so requests don't wait on new TLS handshakes
MONGO_MIN_POOL_SIZE=4
# Build indexes on startup (default: on in dev, off in production -> run `npm run db:indexes` on deploy)
MONGO_AUTO_INDEX=

# --- Caching (ms) ---
HOME_CACHE_MS=60000
LIST_CACHE_MS=30000
DASHBOARD_CACHE_MS=10000
CACHE_MAX_ENTRIES=500
# How often each instance checks for changes made on other instances (0 = off)
CACHE_SYNC_MS=2000

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Mathematical Olympiad <updates@matholympiad.local>"
# Optional: where replies go (e.g. your school/contact inbox). Empty = replies go to EMAIL_FROM.
EMAIL_REPLY_TO=
NOTIFY_POLL_MS=10000
NOTIFY_BATCH_SIZE=100
NOTIFY_CONCURRENCY=5
# Max emails per UTC day across all servers (free plans: Brevo 300, Mailjet 200, SMTP2GO 200). 0 = no limit
NOTIFY_DAILY_LIMIT=0
# Brevo: SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<Login>  SMTP_PASS=<SMTP key>  NOTIFY_DAILY_LIMIT=300

# --- Uploads ---
# Uploads go to Cloudflare R2 automatically when all R2_* values are set (needed for >1 instance);
# otherwise to local disk (UPLOAD_DIR, default backend/uploads).
MAX_UPLOAD_MB=50
UPLOAD_DIR=
# Largest single file for direct browser uploads to R2
MAX_R2_UPLOAD_GB=9.5
# TOTAL bucket cap (R2 free tier = 10 GB). Uploads that would pass it are refused with "storage is full".
R2_STORAGE_LIMIT_GB=9.5
R2_PART_SIZE_BYTES=67108864
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Only for tests/MinIO; leave empty for Cloudflare
R2_ENDPOINT=

# --- Scheduled jobs (run by one instance at a time) ---
JOBS_ENABLED=true
# Recount bucket usage + abort half-finished multipart uploads (default hourly)
STORAGE_RECONCILE_MS=3600000
# Delete uploaded files no record uses (default daily), only if older than the grace period
ORPHAN_CLEANUP_MS=86400000
ORPHAN_GRACE_HOURS=24
# Share of NOTIFY_DAILY_LIMIT usable by sign-up confirmation emails (default 20%, or 500/day when unlimited)
NOTIFY_CONFIRM_DAILY_LIMIT=
