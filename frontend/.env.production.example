# Frontend settings for the live build (`npm run build`). Copy to frontend/.env.production.
# "/api" = call the API through this website's own address (Render rewrite /api/* -> backend).
# Required for login to work in Safari/iPhone when website and API are on different *.onrender.com hosts.
VITE_API_BASE=/api
VITE_REQUEST_TIMEOUT_MS=15000
# TODO: shown on the Contact page (empty = hidden)
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
